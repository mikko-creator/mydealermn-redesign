    {
     "t": "h2",
     "html": "Three ways to shop."
    },
    {
     "t": "grid",
     "blocks": [
      {
       "t": "card",
       "blocks": [
        {
         "t": "h3",
         "html": "In store, in person"
        },
        {
         "t": "p",
         "html": "Feel free to browse the menu in advance for inspiration. You are welcome to chat with a budtender in the store and fine tune the purchase on the sales floor. We also have paper menus for people who don't like screens or technology."
        }
       ]
      },
      {
       "t": "card",
       "blocks": [
        {
         "t": "h3",
         "html": "In store, on an iPad kiosk"
        },
        {
         "t": "p",
         "html": "The hybrid approach if you prefer to shop alone and didn't plan ahead. See the live menu, create a cart, and have it fulfilled while you are in the store. QR codes make it easy to pull the menu up on your phone."
        }
       ]
      },
      {
       "t": "card",
       "blocks": [
        {
         "t": "h3",
         "html": "Online preorder for pickup"
        },
        {
         "t": "p",
         "html": "Place your order now to reserve the inventory for your arrival. This is the quick in and out if you are passing by and already know what you want. Pick up your preorder the same day or the next day only. Orders not picked up by the end of the next day are released back to inventory."
        },
        {
         "t": "links",
         "items": [
          {
           "href": "/bayport",
           "html": "View the menu"
          }
         ]
        }
       ]
      }
     ]
